{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the commands and events that Fast Gallery uses (SEC-02).",
  "windows": ["main", "w*", "settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-list-dir",
    "allow-get-folder-previews",
    "allow-refresh-folder-previews",
    "allow-get-image-info",
    "allow-list-volumes",
    "allow-path-kind",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-cache-info",
    "allow-clear-cache",
    "allow-set-edit-mode",
    "allow-get-edit-mode",
    "allow-trash-files",
    "allow-undo-trash",
    "allow-copy-files",
    "allow-reveal-in-finder",
    "allow-open-with-apps",
    "allow-open-with",
    "allow-open-privacy-settings",
    "allow-start-drag",
    "allow-pick-folder",
    "allow-new-window",
    "allow-open-settings",
    "allow-take-pending-open",
    "allow-toggle-favorite",
    "allow-set-folder-prefs",
    "allow-home-dir"
  ]
}
