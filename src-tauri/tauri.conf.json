{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fast Gallery",
  "version": "0.1.0",
  "identifier": "dev.fastgallery.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' thumb: image: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.photography",
    "shortDescription": "Fast image browser",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      { "ext": ["jpg", "jpeg"], "name": "JPEG image", "role": "Viewer", "mimeType": "image/jpeg" },
      { "ext": ["png"], "name": "PNG image", "role": "Viewer", "mimeType": "image/png" },
      { "ext": ["heic", "heif"], "name": "HEIF image", "role": "Viewer", "mimeType": "image/heic" },
      { "ext": ["webp"], "name": "WebP image", "role": "Viewer", "mimeType": "image/webp" },
      { "ext": ["gif"], "name": "GIF image", "role": "Viewer", "mimeType": "image/gif" },
      { "ext": ["tif", "tiff"], "name": "TIFF image", "role": "Viewer", "mimeType": "image/tiff" },
      { "ext": ["bmp"], "name": "BMP image", "role": "Viewer", "mimeType": "image/bmp" },
      { "ext": ["avif"], "name": "AVIF image", "role": "Viewer", "mimeType": "image/avif" }
    ]
  }
}
