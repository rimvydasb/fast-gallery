{
  "name": "fast-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite",
    "build": "npm run build:frontend",
    "build:frontend": "tsc --noEmit && vite build",
    "build:backend": "tauri build --no-bundle --config '{\"build\":{\"beforeBuildCommand\":\"\"}}'",
    "build:all": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test --lib",
    "tauri": "tauri",
    "bench": "cd src-tauri && cargo bench --bench core",
    "build:universal": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.7"
  }
}
